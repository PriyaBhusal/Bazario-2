@model OnlineRetailStore.Mvc.ViewModels.ProductIndexViewModel
@using OnlineRetailStore.Mvc.Services
@{
    ViewBag.Title = "Products";
}

<div class="dashboard-header">
    <h2>Products</h2>
    <p class="text-muted mb-0">Browse the full Bazario catalog.</p>
</div>

<div class="btn-row mb-4">
    @foreach (var f in Model.Filters)
    {
        <a href="@Url.Action("Index", new { cat = f.Category })" class="btn btn-sm rounded-pill @(f.Active ? "btn-primary" : "btn-outline-secondary")">@f.Label</a>
    }
</div>

<div class="row g-3">
    @foreach (var p in Model.Products)
    {
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card product-card h-100">
                <img src="@Url.Content(p.ImageUrl)" class="card-img-top" alt="@p.Name" />
                <div class="card-body">
                    <small class="text-muted">@p.Category</small>
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text text-muted small">@p.ShortDescription</p>
                    <p class="card-text fw-bold mb-1">@MoneyHelper.Format(p.Price)</p>
                    <p class="card-text"><small class="text-warning">@p.StarsLabel</small></p>
                    <div class="card-actions">
                        @Html.ActionLink("View", "Details", new { id = p.ProductId }, new { @class = "btn btn-sm btn-outline-primary" })
                        @if (p.Stock <= 0)
                        {
                            <button class="btn btn-sm btn-primary disabled" disabled>Out of Stock</button>
                        }
                        else if (!Model.IsLoggedIn)
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-primary disabled" title="Log in to add to cart">Add to Cart</a>
                        }
                        else
                        {
                            using (Html.BeginForm("AddToCart", "Products", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.ProductId" />
                                <button type="submit" class="btn btn-sm btn-primary">Add to Cart</button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Products.Count == 0)
{
    <div class="panel-card p-5 text-center">
        <p class="mb-0 text-muted">No products found in this category yet.</p>
    </div>
}
