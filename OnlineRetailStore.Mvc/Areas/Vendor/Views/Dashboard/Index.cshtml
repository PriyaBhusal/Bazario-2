@model OnlineRetailStore.Mvc.Areas.Vendor.Models.VendorDashboardVm
@using OnlineRetailStore.Mvc.Services
@{
    ViewBag.Title = "Vendor Dashboard";
}

<div class="dashboard-header">
    <h2>Vendor Dashboard</h2>
    <p class="text-muted mb-0">Add and manage the products you sell on Bazario.</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.IsApproved)
{
    <div class="panel-card p-4 text-center">
        <p class="mb-1" style="font-size:1.1rem;">⏳ Pending approval</p>
        <p class="text-muted mb-0">Your vendor account is awaiting admin approval. You'll be able to manage your products as soon as you're approved.</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-num">@Model.StatProducts</div>
                <div class="stat-label">Products</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-num">@Model.StatStock</div>
                <div class="stat-label">Units in stock</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-num">@Model.StatOutOfStock</div>
                <div class="stat-label">Out of stock</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-tile">
                <div class="stat-num">@Model.StatValue</div>
                <div class="stat-label">Inventory value</div>
            </div>
        </div>
    </div>

    <div class="panel-card mb-4" style="max-width:840px;">
        <div class="panel-card-body">
            <div class="panel-title">➕ Add a product</div>
            @using (Html.BeginForm("Add", "Dashboard", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        @Html.DropDownList("CategoryId", (SelectList)ViewBag.Categories, "Select category", new { @class = "form-select" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price</label>
                        <input type="number" step="0.01" min="0" name="Price" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stock</label>
                        <input type="number" min="0" name="Stock" class="form-control" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Image URL</label>
                        <input type="text" name="ImageUrl" class="form-control" placeholder="~/Content/Images/placeholder.svg" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Short description</label>
                        <input type="text" name="ShortDescription" class="form-control" placeholder="Optional" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="Description" rows="2" class="form-control" placeholder="Optional"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill mt-3">Add Product</button>
            }
        </div>
    </div>

    <div class="panel-title">📦 Your products</div>
    <div class="table-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Short Description</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td><img class="row-thumb" src="@Url.Content(p.ImageUrl)" alt="" /></td>
                        <td><span class="fw-semibold">@p.Name</span></td>
                        <td>@p.CategoryName</td>
                        <td>@MoneyHelper.Format(p.Price)</td>
                        <td><span class="status-badge @(p.Stock == 0 ? "out" : p.Stock <= 10 ? "low" : "ok")">@p.Stock</span></td>
                        <td><span class="text-muted">@p.ShortDescription</span></td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Edit", "Edit", new { id = p.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @using (Html.BeginForm("Delete", "Dashboard", new { id = p.Id }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?');">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
