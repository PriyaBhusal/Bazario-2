@model OnlineRetailStore.Mvc.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Register";
}
<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="login-card p-4 p-md-5 rounded-4 shadow-sm" style="max-width:480px; width:100%;">
        <div class="text-center mb-3">
            <h4 class="mb-0">Bazario</h4>
            <h2 class="mt-3">Create your account</h2>
            <p class="text-muted">Join Bazario to start shopping.</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })

            <div class="mb-3">
                @Html.Label("Username", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-lg rounded-3", placeholder = "Jane Doe" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Label("Role", "Account type", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Role, new List<SelectListItem>
                {
                    new SelectListItem { Text = "User", Value = "User", Selected = true },
                    new SelectListItem { Text = "Vendor", Value = "Vendor" }
                }, new { @class = "form-select form-select-lg" })
                <small class="text-muted">Vendor accounts require admin approval before you can list products.</small>
            </div>

            <div class="mb-3">
                @Html.Label("Email", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-lg rounded-3", placeholder = "you@example.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Label("Phone", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control form-control-lg rounded-3", placeholder = "Optional" })
            </div>

            <div class="mb-3">
                @Html.Label("Address", "Delivery address", new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Address, 2, 1, new { @class = "form-control rounded-3", placeholder = "Optional" })
            </div>

            <div class="mb-3">
                @Html.Label("Password", new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-lg rounded-3", placeholder = "At least 8 characters" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Create Account</button>
            </div>
        }

        <div class="text-center">
            <small class="text-muted">Already have an account? @Html.ActionLink("Log in", "Login", "Account")</small>
        </div>
    </div>
</div>
