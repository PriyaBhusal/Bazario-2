@{
    ViewBag.Title = "Payment cancelled";
}
<div class="panel-card p-5 text-center">
    <p style="font-size:1.2rem; font-weight:700;">Payment cancelled</p>
    <p class="text-muted mb-3">Your payment was not completed, so this order was cancelled and any reserved stock was released.</p>
    @Html.ActionLink("Go to My Orders", "Index", "Orders", null, new { @class = "btn btn-primary rounded-pill" })
</div>
