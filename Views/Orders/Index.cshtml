@model System.Collections.Generic.List<OnlineRetailStore.Mvc.ViewModels.OrderStatusViewModel>
@using OnlineRetailStore.Mvc.Services
@{
    ViewBag.Title = "My Orders";
}

<h2>My Orders</h2>
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

@foreach (var order in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h5 class="card-title mb-1">Order #@order.Id</h5>
                    <p class="text-muted mb-1">@order.CreatedAt.ToString("MMM d, yyyy")</p>
                </div>
                <span class="badge @order.StatusBadgeClass">@order.Status</span>
            </div>

            @if (order.Status != "Cancelled")
            {
                <div class="d-flex align-items-center gap-2 my-3 flex-wrap">
                    <span class="badge rounded-pill @order.StepClass(1) px-3 py-2">1. Pending</span>
                    <span class="text-muted">&rarr;</span>
                    <span class="badge rounded-pill @order.StepClass(2) px-3 py-2">2. Sent out for delivery</span>
                    <span class="text-muted">&rarr;</span>
                    <span class="badge rounded-pill @order.StepClass(3) px-3 py-2">3. Delivered</span>
                </div>
            }

            @foreach (var item in order.Items)
            {
                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2 flex-wrap gap-2">
                    <div>@item.ProductName &times;@item.Quantity</div>
                    @if (item.ExistingRating.HasValue)
                    {
                        <span class="text-warning">
                            @(new string('★', item.ExistingRating.Value))<span class="text-muted">@(new string('☆', 5 - item.ExistingRating.Value))</span>
                        </span>
                    }
                    @if (item.ShowRate)
                    {
                        @Html.ActionLink("Rate this product", "Rate", new { orderId = item.OrderId, productId = item.ProductId }, new { @class = "btn btn-sm btn-outline-primary" })
                    }
                </div>
            }

            <p class="mb-0 mt-3"><strong>Total: @MoneyHelper.Format(order.Total)</strong></p>
        </div>
    </div>
}

@if (Model.Count == 0)
{
    <div class="glass-card p-4 text-center">
        <p class="mb-2">You haven't placed any orders yet.</p>
        @Html.ActionLink("Browse Products", "Index", "Products", null, new { @class = "btn btn-primary" })
    </div>
}
