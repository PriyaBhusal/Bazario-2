@model OnlineRetailStore.Mvc.Areas.Vendor.Models.VendorProductVm
@{
    ViewBag.Title = "Edit Product";
}

<div class="dashboard-header">
    <h2>Edit Product</h2>
</div>

<div class="panel-card">
    <div class="panel-card-body">
        @using (Html.BeginForm("Edit", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            @Html.HiddenFor(m => m.Id)
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories, new { @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Price</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Stock</label>
                    @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Image URL</label>
                    @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control" })
                </div>
                <div class="col-12">
                    <label class="form-label">Short description</label>
                    @Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control" })
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    @Html.TextAreaFor(m => m.Description, 2, 1, new { @class = "form-control" })
                </div>
            </div>
            <button type="submit" class="btn btn-primary rounded-pill mt-3">Save</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary rounded-pill mt-3" })
        }
    </div>
</div>
